      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__GMAIL_CONNECTOR_ID__search_threads",
      "mcp__GMAIL_CONNECTOR_ID__get_thread",
      "mcp__GMAIL_CONNECTOR_ID__get_message",
      "mcp__GMAIL_CONNECTOR_ID__list_labels",
